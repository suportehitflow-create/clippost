# Servidor do Editor em Massa (rotas /api/editor-massa/*) no Fly.
# É o mesmo app Next do site; a tela continua na Vercel e chama este servidor,
# porque o FFmpeg precisa de um processo Node persistente com disco.
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:22-slim
# Fontes das legendas automáticas (filtro "ass"/libass): as mesmas do backend
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates wget \
    fonts-dejavu-core fonts-roboto-unhinted fonts-montserrat fontconfig \
    && mkdir -p /usr/local/share/fonts/anton \
    && (wget -q https://github.com/google/fonts/raw/main/ofl/anton/Anton-Regular.ttf -O /usr/local/share/fonts/anton/Anton-Regular.ttf || true) \
    && fc-cache -f >/dev/null 2>&1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production \
    FFMPEG_PATH=/usr/bin/ffmpeg \
    FFPROBE_PATH=/usr/bin/ffprobe \
    EDITOR_MASSA_DIR=/tmp/editor-massa
COPY --from=build /app ./
EXPOSE 8080
CMD ["npx", "next", "start", "-p", "8080"]
