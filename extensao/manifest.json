{
    "manifest_version":  3,
    "name":  "Clipost — Importar do Instagram",
    "short_name":  "Clipost",
    "version":  "1.3.0",
    "description":  "Busca os posts de um perfil do Instagram para o Clipost usando a sua sessão do navegador — direto do site, sem clique.",
    "permissions":  [
                        "storage",
                        "scripting"
                    ],
    "host_permissions":  [
                             "https://www.instagram.com/*",
                             "https://clippost-three.vercel.app/*",
                             "http://localhost:3000/*"
                         ],
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://www.instagram.com/*"
                                            ],
                                "js":  [
                                           "instagram-captura.js"
                                       ],
                                "run_at":  "document_start",
                                "world":  "MAIN"
                            },
                            {
                                "matches":  [
                                                "https://www.instagram.com/*"
                                            ],
                                "js":  [
                                           "instagram.js"
                                       ],
                                "css":  [
                                            "instagram.css"
                                        ],
                                "run_at":  "document_idle"
                            },
                            {
                                "matches":  [
                                                "https://clippost-three.vercel.app/*",
                                                "http://localhost:3000/*"
                                            ],
                                "js":  [
                                           "clipost.js"
                                       ],
                                "run_at":  "document_start"
                            }
                        ],
    "icons":  {
                  "128":  "icone.png"
              },
    "background":  {
                       "service_worker":  "background.js"
                   }
}